<Window x:Class="VergolaModelViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vergola Model Viewer" Width="1400" Height="860" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
        FontFamily="Segoe UI" FontSize="12" Background="White">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpenCommand" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Thanh trên: mở file ngoài trang (ghi vào danh sách gần đây); công cụ xem nằm trong trang (thanh dưới đáy) -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Bar}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="OpenBtn" Style="{StaticResource Button.Primary}" Content="Mở mô hình…" Click="OnOpen"
                            ToolTip="Mở file .glb hoặc trang .html Vergola xuất từ Revit (Ctrl+O)" />
                    <Button x:Name="RecentBtn" Content="Gần đây ▾" Click="OnRecent" ToolTip="Các mô hình mở gần đây">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RecentMenu" Placement="Bottom" />
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="FolderBtn" Content="Mở thư mục" Click="OnFolder" IsEnabled="False"
                            ToolTip="Mở thư mục chứa file đang xem trong File Explorer" />
                    <Button x:Name="SampleBtn" Content="Mô hình mẫu" Click="OnSample" ToolTip="Mở mô hình mẫu để thử các công cụ" />
                </StackPanel>
                <TextBlock x:Name="LibText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,4,0"
                           Foreground="{StaticResource Brush.TextMuted}" />
                <TextBlock x:Name="FileText" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.TextMuted}" Text="Kéo thả file .glb vào cửa sổ, hoặc bấm Mở mô hình…" />
            </DockPanel>
        </Border>

        <wv2:WebView2 x:Name="Web" Grid.Row="1" DefaultBackgroundColor="White" />

        <!-- Hiện khi máy thiếu WebView2 Runtime hoặc khởi động lỗi -->
        <Border x:Name="ErrorPanel" Grid.Row="1" Background="White" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
                <TextBlock Text="Không khởi động được khung xem" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,8" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{StaticResource Brush.Text}" Margin="0,0,0,12" />
                <Button x:Name="RuntimeBtn" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}"
                        Content="Tải Microsoft Edge WebView2 Runtime" Click="OnGetRuntime" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
